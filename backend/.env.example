ENVIRONMENT=local
APP_NAME=CaseMap AI
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://casemap:casemap@db:5432/casemap

JWT_SECRET_KEY=change-this-in-prod-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=720

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
RATE_LIMIT_DEFAULT=60/minute

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

LLM_PROVIDER_DEFAULT=ollama
ALLOW_PROVIDER_OVERRIDE=true

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FAISS_INDEX_PATH=./data/faiss/index.faiss
FAISS_METADATA_PATH=./data/faiss/metadata.json
RETRIEVAL_TOP_K=5

